SQL> set echo on
SQL> 
SQL> --
SQL> -- One way of gathering extended stats
SQL> --
SQL> @@gather_ext
SQL> --
SQL> -- Gathers statistics on
SQL> -- extended statistics that don't yet have stats
SQL> --
SQL> set serveroutput on
SQL> declare
  2     cursor ext is
  3        select a.table_name,a.extension
  4        from   user_stat_extensions a,
  5               user_tab_col_statistics b
  6        where  a.table_name = b.table_name (+)
  7        and    a.extension_name = b.column_name (+)
  8        and    b.last_analyzed is null
  9        order by table_name;
 10     cmd varchar2(4096);
 11  begin
 12     for rec in ext
 13     loop
 14        cmd := 'begin  dbms_stats.gather_table_stats(user,'''||rec.table_name||''',method_opt=>''for columns '||rec.extension||''',no_invalidate=>false); end;';
 15        dbms_output.put_line(cmd);
 16        execute immediate cmd;
 17     end loop;
 18  end;
 19  /
begin  dbms_stats.gather_table_stats(user,'TAB_CORR1',method_opt=>'for columns ("N1","N2")',no_invalidate=>false); end;
begin  dbms_stats.gather_table_stats(user,'TAB_CORR2',method_opt=>'for columns ("N1","N2")',no_invalidate=>false); end;

PL/SQL procedure successfully completed.

SQL> set serveroutput off
SQL> --
SQL> -- Alternatively you can do this
SQL> --
SQL> --exec dbms_stats.gather_table_stats(user,'tab_corr1',no_invalidate=>false);
SQL> --exec dbms_stats.gather_table_stats(user,'tab_corr2',no_invalidate=>false);
SQL> 
SQL> --
SQL> -- Expose the next query to the column group statistics
SQL> -- and the cardinality estimate will be correct (1000)
SQL> --
SQL> 
SQL> select /* MY_TEST_QUERY */ /*+ GATHER_PLAN_STATISTICS */ sum(b.n0),count(*)
  2  from  tab_corr1 a, tab_corr2 b
  3  where a.n1 = 1
  4  and   a.n2 = 1
  5  and   a.n1 = b.n1
  6  and   a.n2 = b.n2;

 SUM(B.N0)   COUNT(*)
---------- ----------
      1000       1000

