SQL> 
SQL> define sqlid
DEFINE SQLID           = "bu6pvfqz1cys2" (CHAR)
SQL> 
SQL> @cg_from_sqlid &sqlid y
SQL> --
SQL> -- For a given SQL ID, parse and create column groups
SQL> -- Parameters:
SQL> --    SQL ID
SQL> --    Y/N - where Y - create column groups immediately
SQL> --                N - spool a reation script to verify and run later
SQL> --
SQL> set long 100000
SQL> 
SQL> var create_now varchar2(1)
SQL> 
SQL> exec select decode(nvl(upper('&2'),'N'),'N','N','Y') into :create_now from dual;

PL/SQL procedure successfully completed.

SQL> --
SQL> -- This assumes that the parse will complete within 10-1 seconds
SQL> --
SQL> exec dbms_stats.seed_col_usage(null,null,10)

PL/SQL procedure successfully completed.

SQL> exec dbms_lock.sleep(1)

PL/SQL procedure successfully completed.

SQL> 
SQL> DECLARE
  2    l_sql   CLOB;
  3    l_cur   INTEGER;
  4  BEGIN
  5    SELECT sql_fulltext
  6    INTO   l_sql
  7    FROM   sys.GV_$SQLAREA
  8    WHERE  sql_id = '&1'
  9    AND    ROWNUM = 1;
 10  
 11    l_cur := dbms_sql.open_cursor;
 12  
 13    BEGIN
 14      dbms_sql.parse(l_cur, l_sql, dbms_sql.native);
 15      dbms_output.put_line('Parse succeeded');
 16    EXCEPTION
 17      WHEN OTHERS THEN
 18        dbms_output.put_line('Parse failed: ' || SQLERRM);
 19    END;
 20  
 21    dbms_sql.close_cursor(l_cur);
 22  END;
 23  /
old   8:   WHERE  sql_id = '&1'
new   8:   WHERE  sql_id = 'bu6pvfqz1cys2'

PL/SQL procedure successfully completed.

SQL> 
SQL> --
SQL> -- Create the column groups
SQL> --
SQL> exec dbms_stats.flush_database_monitoring_info;

PL/SQL procedure successfully completed.

SQL> exec dbms_lock.sleep(2)

PL/SQL procedure successfully completed.

SQL> 
SQL> set serveroutput on
SQL> declare
  2    r clob;
  3    cursor c1 is
  4      select distinct object_name,object_owner
  5      from   sys.GV_$SQL_PLAN
  6      where  object_type = 'TABLE'
  7      and    sql_id = '&1'
  8      order by object_name;
  9  begin
 10    for rec in c1
 11    loop
 12       r := dbms_stats.report_col_usage(rec.object_owner,rec.object_name) ;
 13       dbms_output.put_line('-- ===========================================================');
 14       dbms_output.put_line('--     Table Name  : '||rec.object_name);
 15       dbms_output.put_line('/*');
 16       dbms_output.put_line(r);
 17       dbms_output.put_line('*/');
 18       if :create_now = 'Y'
 19       then
 20          select dbms_stats.create_extended_stats(rec.object_owner,rec.object_name) into r from dual;
 21          dbms_output.put_line(r);
 22       else
 23          dbms_output.put_line('select dbms_stats.create_extended_stats('''||rec.object_owner||''','''||rec.object_name||''') es from dual;');
 24       end if;
 25    end loop;
 26    dbms_output.put_line('-- === Stats need to be regathered on the following tables');
 27    for rec in c1
 28    loop
 29       -- In theory, we could go ahead and gather stats here rather than just reporting the need.
 30       dbms_output.put_line('exec dbms_stats.gather_table_stats('''||rec.object_owner||''','''||rec.object_name||''',no_invalidate=>false)');
 31    end loop;
 32  end;
 33  /
old   7:     and    sql_id = '&1'
new   7:     and    sql_id = 'bu6pvfqz1cys2'
