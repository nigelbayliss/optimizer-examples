SQL> @i2
========================================
Set up the table for incremental stats
========================================
SQL> BEGIN
  2    DBMS_STATS.SET_TABLE_PREFS(
  3      ownname => USER,
  4      tabname => 'SALES_DATA',
  5      pname   => 'INCREMENTAL',
  6      pvalue  => 'TRUE'
  7    );
  8  END;
  9  /

